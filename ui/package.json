{
  "name": "ulpf-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:nomock": "ULPF_NO_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check:offline": "node scripts/offline-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:offline"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.1.0",
    "@fontsource/instrument-sans": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@tanstack/react-query": "5.62.7",
    "@tanstack/react-table": "8.20.6",
    "@tanstack/react-virtual": "3.10.9",
    "echarts": "5.5.1",
    "monaco-editor": "0.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "ws": "8.18.0"
  }
}
